rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Produtos: leitura pública, escrita permitida para usuários autenticados
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Leads VIP da página Em Breve: visitantes públicos podem cadastrar e-mail
    match /leads_vip/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
