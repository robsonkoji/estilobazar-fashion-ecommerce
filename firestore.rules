rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção de Produtos: Leitura e escrita permitidas para gestão completa do catálogo
    match /products/{productId} {
      allow read, write: if true;
    }
    // Coleção de Leads VIP: Leitura e escrita permitidas para inscrição de visitantes
    match /leads_vip/{leadId} {
      allow read, write: if true;
    }
  }
}
